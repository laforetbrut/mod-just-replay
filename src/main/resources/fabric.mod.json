{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "justreplay_logo.png",
  "environment": "client",
  "accessWidener": "${mod_id}.classtweaker",
  "entrypoints": {
    "client": [
      "com.vyrriox.justreplay.fabric.JustReplayFabric"
    ],
    "voicechat": [
      "com.vyrriox.justreplay.voice.plugin.JustReplayVoicechatPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.compat.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25"
  }
}
